            "sense": "max",
            "n_variables": 3,
            "objective": ["1", "1", "1"],
            "constraints": [
                {"x1": "1", "x2": "1", "x3": "1", "rel": "<=", "rhs": "1"},
            ],
        })
        assert not errors
        with self.assertRaises(ValueError):
