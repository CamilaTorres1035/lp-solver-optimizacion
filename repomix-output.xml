    def test_validate_model_form_returns_errors_for_invalid_form(self):
        """Devuelve errores y ningún modelo cuando el formulario es inválido."""
        form = {
            "sense": "average",
            "n_variables": 1,
            "objective": ["abc"],
            "constraints": [
                {"x1": "1", "rel": "!=", "rhs": "2"},
            ],
